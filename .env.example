# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Redis
REDIS_PASSWORD=change_me

# Application internal secrets
JWT_SECRET=replace_with_base64_encoded_32_random_bytes
GATEWAY_SECRET=replace_with_random_shared_secret
INTERNAL_SECRET_TOKEN=replace_with_64_hex_characters

# Optional: Grafana credentials, if configured in Compose
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me







