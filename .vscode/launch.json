{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "TransferServiceApplication",
      "request": "launch",
      "mainClass": "com.dfls.transfer_service.TransferServiceApplication",
      "projectName": ""
    },
    {
      "type": "java",
      "name": "API Gateway",
      "request": "launch",
      "mainClass": "com.dfls.api_gateway.ApiGatewayApplication",
      "vmArgs": "-javaagent:${workspaceFolder}/tools/opentelemetry-javaagent.jar",
      "env": {
        "OTEL_SERVICE_NAME": "api-gateway",
        "OTEL_TRACES_EXPORTER": "logging",
        "OTEL_LOGS_EXPORTER": "none",
        "OTEL_METRICS_EXPORTER": "none"
      }
    },
    {
      "type": "java",
      "name": "Identity Service",
      "request": "launch",
      "mainClass": "com.dfls.identity_service.IdentityServiceApplication",
      "vmArgs": "-javaagent:${workspaceFolder}/tools/opentelemetry-javaagent.jar",
      "env": {
        "OTEL_SERVICE_NAME": "identity-service",
        "OTEL_TRACES_EXPORTER": "none",
        "OTEL_LOGS_EXPORTER": "none",
        "OTEL_METRICS_EXPORTER": "none"
      }
    },
    {
      "type": "java",
      "name": "Account Service",
      "request": "launch",
      "mainClass": "com.dfls.account_service.AccountServiceApplication",
      "vmArgs": "-javaagent:${workspaceFolder}/tools/opentelemetry-javaagent.jar",
      "env": {
        "OTEL_SERVICE_NAME": "account-service",
        "OTEL_TRACES_EXPORTER": "none",
        "OTEL_LOGS_EXPORTER": "none",
        "OTEL_METRICS_EXPORTER": "none"
      }
    },
    {
      "type": "java",
      "name": "Transfer Service",
      "request": "launch",
      "mainClass": "com.dfls.tranfer_service.TransferServiceApplication",
      "vmArgs": "-javaagent:${workspaceFolder}/tools/opentelemetry-javaagent.jar",
      "env": {
        "OTEL_SERVICE_NAME": "transfer-service",
        "OTEL_TRACES_EXPORTER": "none",
        "OTEL_LOGS_EXPORTER": "none",
        "OTEL_METRICS_EXPORTER": "none"
      }
    }
  ]
}